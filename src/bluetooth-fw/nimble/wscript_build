# debug_log_service.c: plain-GATT firmware-log readout (observability without PPoG).
# Now uses a 16-bit service UUID (the earlier 128-bit *service* UUID failed inside
# ble_gatts_start() on obelix and bricked the HCPU on boot), so it is built again.
excludes = []
if not bld.env.CONFIG_GH3X2X_TUNING_SERVICE_ENABLED:
    excludes.extend(['gh3x2x_tuning_service.c'])

driver_source = bld.path.ant_glob(['*.c'], excl=excludes)

bld.objects(
    source=driver_source,
    target='bt_driver',
    use=[
      'nimble',
      'freertos',
      'fw_includes',
      'pbl_includes',
    ],
)

