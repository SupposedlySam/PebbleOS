diff --git a/drivers/hal/bf0_hal_mpi.c b/drivers/hal/bf0_hal_mpi.c
index 675f3bff..6102181f 100644
--- a/drivers/hal/bf0_hal_mpi.c
+++ b/drivers/hal/bf0_hal_mpi.c
@@ -213,7 +213,17 @@ __HAL_ROM_USED HAL_StatusTypeDef HAL_FLASH_SET_CMD(FLASH_HandleTypeDef *hflash,
     }
     hflash->Instance->CMDR1 = cmd & 0XFF;
 
-    while (!HAL_FLASH_IS_CMD_DONE(hflash));
+    {
+        // PEBBLE: bound this spin (mirrors the CAL_DELAY guard in bf0_hal_mpi_psram.c). The
+        // original `while(!IS_CMD_DONE);` has NO timeout, so a device that never asserts TCF
+        // (e.g. PSRAM not acking the CR0 write after a clock/DQS reconfigure) wedges KernelBG
+        // forever. Callers ignore the return, so on timeout we just proceed -- the PSRAM
+        // tap-sweep / read-back test then catches a truly dead part instead of hanging.
+        volatile uint32_t guard = 4000000u;
+        while (!HAL_FLASH_IS_CMD_DONE(hflash)) {
+            if (--guard == 0) { res = HAL_TIMEOUT; break; }
+        }
+    }
     HAL_FLASH_CLR_CMD_DONE(hflash);
 
     return res;
diff --git a/drivers/hal/bf0_hal_mpi_psram.c b/drivers/hal/bf0_hal_mpi_psram.c
index 7d49cdaa..8bfd6ff5 100644
--- a/drivers/hal/bf0_hal_mpi_psram.c
+++ b/drivers/hal/bf0_hal_mpi_psram.c
@@ -1174,7 +1174,19 @@ static int HAL_MPI_OPSRAM_CAL_DELAY(FLASH_HandleTypeDef *hflash, uint8_t *sck, u
     //HAL_Delay_us(20);  // add delay to avoid CDC during cal_done polling
     HAL_Delay_us_psram(0);
     HAL_Delay_us_psram(20);
-    while (!(hflash->Instance->CALCR & MPI_CALCR_DONE_Msk));
+    /* PEBBLE: bound this spin. The original `while(!(CALCR & DONE));` has NO timeout, so
+     * if the calibration DONE bit never asserts (wrong read strobe / non-responding
+     * part) it wedges KernelBG forever -> watchdog reboot loop. Cap it; on timeout we
+     * fall through with whatever DELAY holds (the caller's off-center tap is overridden
+     * by psram.c's explicit tap sweep anyway). ~a few ms at 240MHz. */
+    {
+        volatile uint32_t guard = 4000000u;
+        while (!(hflash->Instance->CALCR & MPI_CALCR_DONE_Msk)) {
+            if (--guard == 0) {
+                break;
+            }
+        }
+    }
     delay = hflash->Instance->CALCR & MPI_CALCR_DELAY_Msk;
     hflash->Instance->CALCR &= ~MPI_CALCR_EN;
 
diff --git a/drivers/hal/bf0_hal_rcc.c b/drivers/hal/bf0_hal_rcc.c
index d80e0065..c9f168bf 100644
--- a/drivers/hal/bf0_hal_rcc.c
+++ b/drivers/hal/bf0_hal_rcc.c
@@ -1618,8 +1618,19 @@ __HAL_ROM_USED HAL_StatusTypeDef HAL_RCC_HCPU_EnableDLL(int dll, uint32_t freq)
     HAL_Delay_us(0);
     /** wait for DLL ready, 5us at least */
     HAL_Delay_us(10);
-    while (0 == ((*cr) & HPSYS_RCC_DLL1CR_READY))
-    {
+    /* PEBBLE: bound this DLL-ready spin (mirrors the MPI CAL/TCF guards). The original
+     * `while(!(DLLxCR & READY)){}` has NO timeout, so a DLL that never locks wedges the
+     * caller forever. Cap it; on timeout fall through (status still HAL_OK -- the caller
+     * verifies the actual frequency afterward, and PSRAM bring-up reads back DLL2 freq and
+     * aborts if it's 0). ~tens of ms at 240MHz, far longer than a real lock (<=tens of us). */
+    {
+        volatile uint32_t guard = 8000000u;
+        while (0 == ((*cr) & HPSYS_RCC_DLL1CR_READY))
+        {
+            if (--guard == 0) {
+                break;
+            }
+        }
     }
 
     status = HAL_OK;
@@ -1683,8 +1694,19 @@ __HAL_ROM_USED HAL_StatusTypeDef HAL_RCC_HCPU_EnableDLL(int dll, uint32_t freq)
     HAL_Delay_us(0);
     /** wait for DLL ready, 5us at least */
     HAL_Delay_us(10);
-    while (0 == ((*cr) & HPSYS_RCC_DLL1CR_READY))
-    {
+    /* PEBBLE: bound this DLL-ready spin (mirrors the MPI CAL/TCF guards). The original
+     * `while(!(DLLxCR & READY)){}` has NO timeout, so a DLL that never locks wedges the
+     * caller forever. Cap it; on timeout fall through (status still HAL_OK -- the caller
+     * verifies the actual frequency afterward, and PSRAM bring-up reads back DLL2 freq and
+     * aborts if it's 0). ~tens of ms at 240MHz, far longer than a real lock (<=tens of us). */
+    {
+        volatile uint32_t guard = 8000000u;
+        while (0 == ((*cr) & HPSYS_RCC_DLL1CR_READY))
+        {
+            if (--guard == 0) {
+                break;
+            }
+        }
     }
 
     status = HAL_OK;
